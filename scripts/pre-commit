#!/bin/sh
set -e

ROOT_DIR=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

# Backend
cd "$ROOT_DIR/backend"

UNFORMATTED=$(gofmt -l .)
if [ -n "$UNFORMATTED" ]; then
    echo "Unformatted Go files found:"
    echo "$UNFORMATTED"
    echo "Run 'gofmt -w .' in backend to fix."
    exit 1
fi

go mod tidy
if ! git diff --exit-code go.mod go.sum >/dev/null 2>&1; then
    echo "go.mod or go.sum has uncommitted changes. Run 'go mod tidy' and stage changes."
    exit 1
fi

if command -v golangci-lint >/dev/null 2>&1; then
    golangci-lint run
else
    go vet ./...
fi

go test ./... -short

VULNCHECK_BIN="govulncheck"
if ! command -v "$VULNCHECK_BIN" >/dev/null 2>&1; then
    GOPATH_BIN="$(go env GOPATH)/bin"
    if [ -x "$GOPATH_BIN/govulncheck.exe" ]; then
        VULNCHECK_BIN="$GOPATH_BIN/govulncheck.exe"
    elif [ -x "$GOPATH_BIN/govulncheck" ]; then
        VULNCHECK_BIN="$GOPATH_BIN/govulncheck"
    fi
fi

if command -v "$VULNCHECK_BIN" >/dev/null 2>&1 || [ -x "$VULNCHECK_BIN" ]; then
    "$VULNCHECK_BIN" ./...
fi

# Frontend
cd "$ROOT_DIR/frontend"

# Never call the npx/npm shims here: on Windows (nvm4w) the extensionless
# shims are not executable from the hook shell and fail with
# "bash: C:/nvm4w/nodejs/npx: No such file or directory".
# Run the locally installed compiler through node instead.
TSC_JS="node_modules/typescript/bin/tsc"

if [ ! -f "$TSC_JS" ]; then
    echo "frontend/node_modules is missing; skipping TypeScript check (run 'npm ci' first)."
elif command -v node >/dev/null 2>&1 && node -e "process.exit(0)" >/dev/null 2>&1; then
    node "$TSC_JS" --noEmit
elif command -v node.exe >/dev/null 2>&1; then
    node.exe "$TSC_JS" --noEmit
else
    echo "node not found; cannot run tsc --noEmit." >&2
    exit 1
fi

exit 0
