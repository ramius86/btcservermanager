# --- REQUIRED ---
# Steam Web API Key (Required for Steam Workshop features)
# Get one at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# --- OPTIONAL BUT RECOMMENDED ---
# System Timezone (Used for logs and scheduled tasks)
TIMEZONE=Europe/Rome

# Encryption key for sensitive data (like Steam Guard credentials).
# IMPORTANT: Once set and used to save credentials, DO NOT CHANGE IT or you will lose access to them.
# How to generate a random key (32+ chars recommended):
#   - Online (Safe): https://bitwarden.com/password-generator/ or https://1password.com/password-generator/
#   - PowerShell:   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | % {[char]$_})
#   - OpenSSL:      openssl rand -base64 32
SECRET_KEY=change-me-to-something-secure

# --- SECURITY & CLOUDFLARE ZERO TRUST ---
# Restricted CORS and CSP origin (e.g. https://panel.yourdomain.com)
ALLOWED_ORIGIN=
# Cloudflare Access Team Domain (e.g. https://yourteam.cloudflareaccess.com)
CF_TEAM_DOMAIN=
# Cloudflare Tunnel Token (Required if using the cloudflared service in docker-compose)
TUNNEL_TOKEN=
# Cloudflare Zone ID (Required for purging cache on scenario deletion)
CF_ZONE_ID=
# Cloudflare API Token with 'Purge Cache' permission (Required for purging cache on scenario deletion)
CF_API_TOKEN=

# --- OPTIONAL FASTDL CONFIGURATION ---
# Port for the FastDL HTTP mission serving (default: 8081)
FASTDL_PORT=8081
# Public FastDL domain (E.g. fastdl.yourdomain.com - without protocol or port)
FASTDL_DOMAIN=

# --- CSP (Content Security Policy) ---
# Set to true to enable CSP headers (recommended for production)
CSP_ENABLED=false
# Mode: "report-only" or "enforce"
# - "report-only": Logs violations to the browser console but DOES NOT block anything. 
#   Use this first to ensure your dashboard works correctly without errors.
# - "enforce": Actively blocks any resource that violates the policy. 
#   Switch to this only after verifying there are no unexpected warnings in report-only mode.
CSP_MODE=report-only

# --- DEBUG ---
# Set to true to enable verbose logging (useful for troubleshooting server startup)
DEBUG=true
# Set to true to enable the pprof debug server for runtime memory/CPU profiling
# Access at http://localhost:6060/debug/pprof/ (or use `go tool pprof`)
PPROF_ENABLED=false
# Port for the pprof debug server (default: 6060)
# PPROF_PORT=6060
# Port/IP to bind pprof to on the host machine (default: 127.0.0.1:6060 for security)
# PPROF_HOST_PORT=127.0.0.1:6060


# --- UI / COSMETIC ---
# Set to true to enable the "Fox Easter Egg" on the dashboard
FOX_EASTER_EGG=false

# --- PATHS & VOLUMES ---
# [RECOMMENDED] The actual directory path on your server (Host) where all data is stored.
# If not specified, docker-compose will fall back to './storage'.
# HOST_STORAGE_PATH=./storage

# [ADVANCED] Storage path *inside* the container. Do not modify unless
# you also change the volume bindings in docker-compose.yml.
# STORAGE_PATH=/app/storage

# [ADVANCED] Specific subdirectories *inside* the container.
# If left commented out, these are automatically resolved and created under STORAGE_PATH
# (e.g. /app/storage/servers, /app/storage/mods, etc.).
# Only uncomment and change them if you have custom directory layout needs
# (e.g., placing mods on a separate SSD volume).
# DIRECTORY_SERVERS=
# DIRECTORY_MODS=
# DIRECTORY_LOGS=
# DATABASE_URL=

# --- STEAMCMD CONFIGURATION ---
# STEAMCMD_PATH=/home/steam/steamcmd/steamcmd.sh
# STEAMCMD_CACHE_PATH=

# --- ADVANCED CONFIGURATION ---
# Days to keep logs before deletion (default: 30)
LOG_RETENTION_DAYS=30

# Maximum size for scenario uploads in bytes (default: 100MB)
MAX_SCENARIO_SIZE=104857600

# Semicolon separated list of additional mod IDs to always include
ADDITIONAL_MODS=

# --- GAME SERVER PORT CONFIGURATION ---
# Format: [HOST_IP:]HOST_PORT:CONTAINER_PORT[/PROTOCOL]
# To completely disable public exposure for a game server, bind it to 127.0.0.1 (default safe state).
# To expose it to the internet, bind it to 0.0.0.0 or omit the IP.

# --- Arma 3 ---
# Game Ports (Default: 2302-2306)
ARMA3_GAME_PORTS=127.0.0.1:2302-2306:2302-2306/udp
# Steam Query Ports (Default: 2312-2316)
ARMA3_STEAM_PORTS=127.0.0.1:2312-2316:2312-2316/udp

# --- DayZ ---
# Game Ports (Game: 2402, Reserved: 2403, BattlEye: 2404, RCON: 2405)
# Shifted from 2302-2305 to 2402-2405 to avoid conflicts with Arma 3
DAYZ_GAME_PORTS=127.0.0.1:2402-2405:2402-2405/udp
# Steam Query Port (Default: 27016)
DAYZ_STEAM_PORTS=127.0.0.1:27016:27016/udp

# --- Arma Reforger ---
# Game Port (Default: 2001)
REFORGER_GAME_PORTS=127.0.0.1:2001:2001/udp
# A2S Query Port (Default: 17777)
REFORGER_A2S_PORTS=127.0.0.1:17777:17777/udp
# RCON Port (Default: 19999)
REFORGER_RCON_PORTS=127.0.0.1:19999:19999/udp

# --- MISC ---
# PORT=8080
# VERSION=latest

# --- DISCORD EVENTS ---
# Bot token from Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=
# Guild (server) ID where the bot operates
DISCORD_GUILD_ID=